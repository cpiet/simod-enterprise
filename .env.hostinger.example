# SIMOD Enterprise: contoh .env untuk Hostinger (salin menjadi .env di server, lalu isi nilai yang bertanda <...>).
# JANGAN meng-commit berkas .env yang sudah berisi kata sandi.
APP_NAME="SIMOD Enterprise"
APP_ENV=production
APP_KEY=                     # isi lewat: php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Basis data: buat di hPanel -> Databases -> MySQL. Dari aplikasi yang berjalan di server yang sama, host = 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<pengguna_database>
DB_PASSWORD=<kata_sandi_database>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Token API ingest worker (isi string acak panjang bila memakai worker Python; kosong = API ditolak)
INGEST_API_TOKEN=
APIFY_API_TOKEN=             # opsional; token juga dapat diisi dari menu Mesin Intelijen AI

# Demo Divhumas + Polda percontohan
SIMOD_NATIONAL_AGGREGATE=false
SIMOD_SEED_SAMPLE=false
SIMOD_SOCIAL_SYNTHETIC=false
MEDIA_RETENTION_DAYS=90

INERTIA_DEVTOOLS_ENABLED=false
